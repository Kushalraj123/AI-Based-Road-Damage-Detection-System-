# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database Name
MONGODB_DB_NAME=road_damage_db

# Server Configuration
HOST=127.0.0.1
PORT=8000
RELOAD=True

# CORS Allowed Origins (comma-separated, e.g. http://localhost:5173,http://127.0.0.1:5173 or *)
CORS_ORIGINS=*

# Storage Paths
UPLOAD_DIR=uploads
PROCESSED_DIR=processed
HISTORY_FILE=history.json
